# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets (LOGZIO_TOKEN) to the repo. main.ts loads .env
# via dotenv before anything else runs.

PORT=3000
# STORAGE_DIR=./storage

# --- Logz.io log shipping ------------------------------------------------
# Console logging is always on. Set LOGZIO_TOKEN to also ship every log
# line to Logz.io; omit it entirely to stay console-only.
LOGZIO_TOKEN=
LOGZIO_TYPE=blob-server
LOGZIO_PROTOCOL=https
LOGZIO_PORT=8071
# Region-specific listener host, e.g. listener-eu.logz.io
LOGZIO_HOST=listener.logz.io

# --- Auto-registration to a load balancer (optional) -------------------
# Set MASTER_NODE_ADDRESS to have this server announce itself to a running
# 06-load-balancer on startup. All of these are ignored unless it is set.
# MASTER_NODE_ADDRESS=localhost:3000
# ADVERTISED_HOST=localhost
# NODE_NAME=
# SELF_REGISTRATION_RETRY_SECONDS=30
