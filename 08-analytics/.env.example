# Copy this file to .env for local (non-Docker) runs. .env is gitignored.
# docker-compose.yml sets these directly for the api/cleaner containers -
# this file only matters when running `npm start`/`npm run start:cleaner`
# against a Postgres you started yourself (e.g. `docker compose up db`).
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/analytics
