# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets (LOGZIO_TOKEN) to the repo.

PORT=3000
REGISTRATION_DURATION_SECONDS=20

# Logz.io shipping token - the account-level "Token" (not an API token),
# found under Account Settings, or shown alongside the listener host when
# setting up log shipping. Omit this var entirely to run console-only.
LOGZIO_TOKEN=
LOGZIO_TYPE=load-balancer
LOGZIO_PROTOCOL=https
LOGZIO_PORT=8071
# Region-specific listener host, e.g. listener-eu.logz.io - check which
# region your Logz.io account is on.
LOGZIO_HOST=listener.logz.io
